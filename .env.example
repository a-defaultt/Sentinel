# NVIDIA Build API (Free Tier: One key per model)
NVIDIA_PRIMARY_KEY=your_primary_model_key_here
NVIDIA_FALLBACK_KEY=your_fallback_model_key_here
NVIDIA_EMBEDDING_KEY=your_embedding_model_key_here
NVIDIA_RERANKING_KEY=your_reranking_model_key_here
NVIDIA_TIMEOUT_SECONDS=45

# Threat Intelligence
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=sentinel@yourdomain.com
SMTP_TO=soc-team@yourdomain.com

# Webhook Configuration
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# Paths
DATA_DIR=/app/data
CHROMA_DATA_PATH=/app/chroma_data
# docker-compose mounts the Wazuh alerts directory at /app/wazuh-alerts
ALERTS_JSON_PATH=/app/wazuh-alerts/alerts.json

# Pipeline
MIN_RULE_LEVEL=10

# Logging
LOG_LEVEL=INFO

# Google Sheets threat intel feed (GridPulse IOCs)
# Service account key with read access to the shared sheet
GOOGLE_SHEETS_CREDENTIALS_PATH=/app/data/google-service-account.json
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_WORKSHEET_NAME=IOCs
GOOGLE_SHEETS_SYNC_ENABLED=true

# Wazuh API (SOAR active response)
WAZUH_API_URL=https://your-wazuh-manager:55000
WAZUH_API_USER=your_wazuh_api_user
WAZUH_API_PASS=your_wazuh_api_password
# true / false / path to a CA bundle (Wazuh ships self-signed by default)
WAZUH_API_VERIFY_SSL=true
# Must match an <active-response> command on the manager; prefix with '!'
# to run a script by name on Wazuh >= 4.2
WAZUH_AR_COMMAND=firewall-drop

# SOAR guardrails
# AUDIT logs actions without executing; ENFORCE executes them
SOAR_MODE=AUDIT
SOAR_MAX_ACTIONS_PER_HOUR=5
# Comma-separated IPs that must never be blocked (gateway, DNS, manager)
SOAR_PROTECTED_IPS=
# ISOLATE_HOST stays disabled unless explicitly set to true
SOAR_ALLOW_ISOLATE=false
